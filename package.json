{
  "name": "longstone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "longstone": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "demo:e2e": "tsx scripts/demo-e2e.ts"
  },
  "dependencies": {
    "@hisaishi/gateway": "workspace:*",
    "@menhir/core": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "commander": "15.0.0",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}