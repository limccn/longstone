{
  "name": "@limccn/longstone",
  "version": "0.1.1",
  "mcpName": "io.github.limccn/longstone",
  "private": false,
  "description": "Sovereign agent-memory client: MCP server and CLI that sign locally and anchor memories on an Ethereum chain.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limccn/longstone.git"
  },
  "homepage": "https://github.com/limccn/longstone",
  "bugs": {
    "url": "https://github.com/limccn/longstone/issues"
  },
  "keywords": [
    "memory",
    "mcp",
    "ai-agent",
    "ethereum",
    "longstone"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "longstone": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "demo:e2e": "tsx scripts/demo-e2e.ts",
    "prepublishOnly": "pnpm build && pnpm test",
    "publish:npm": "pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org/",
    "publish:gh": "pnpm publish --access public --no-git-checks --registry https://npm.pkg.github.com/",
    "pack:check": "pnpm pack"
  },
  "dependencies": {
    "@limccn/hisaishi-gateway": "workspace:*",
    "@limccn/menhir-core": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "commander": "15.0.0",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}